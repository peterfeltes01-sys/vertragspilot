generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Konto {
  id          Int        @id @default(autoincrement())
  bezeichnung String
  iban        String?
  vertraege   Contract[]
}

model Contract {
  id                   Int       @id @default(autoincrement())
  lastCheck            DateTime?
  kategorie            String
  vertrag              String
  vertragspartner      String?
  web                  String?
  kundennummer         String?
  kontoId              Int?
  konto                Konto?    @relation(fields: [kontoId], references: [id])
  vertragsbeginn       DateTime?
  aktuellerBeginn      DateTime?
  vertragsende         DateTime?
  laufzeit             String?
  kuendigungsfrist     String?
  naechsteKuendigung   DateTime?
  naechsteErinnerung   DateTime?
  kosten               Float?
  zahlungsintervall    String?
  notizen              String?
  archiviert           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  laufzeitMonate       Int?
  kuendigungsfristMonate Int?
  autoVerlaengerung    Boolean   @default(true)
  verlaengerungMonate  Int?
  gekuendigt           Boolean   @default(false)
  kuendigungsDatum     DateTime?
  zuPruefen            Boolean   @default(false)
  reminderEnabled      Boolean   @default(true)
  reminderDismissed    DateTime?
  calendarEventId              String?
  calendarSynced               Boolean   @default(false)
  calendarEventIdVertragsende  String?
  calendarSyncedVertragsende   Boolean   @default(false)
  dokumente            Document[]
  historie             ContractHistory[]
  erinnerungen         Reminder[]
  preisvergleiche      PriceComparison[]
}

model GoogleAuth {
  id            Int      @id @default(autoincrement())
  accessToken   String
  refreshToken  String
  tokenExpiry   DateTime
  email         String?
  calendarId    String   @default("primary")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Document {
  id               Int      @id @default(autoincrement())
  contractId       Int
  contract         Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  dateiname        String
  dateipfad        String
  dateityp         String
  dateigroesse     Int
  bezeichnung      String?
  kategorie        String   @default("sonstiges")
  uploadDatum      DateTime @default(now())
  createdAt        DateTime @default(now())
  analyseergebnis  Json?
  analysiertAm     DateTime?
}

model GesamtAnalyse {
  id        Int      @id @default(autoincrement())
  ergebnis  Json
  createdAt DateTime @default(now())
}

model MarktVergleich {
  id        Int      @id @default(autoincrement())
  ergebnis  Json
  createdAt DateTime @default(now())
}

model ContractHistory {
  id           Int      @id @default(autoincrement())
  contractId   Int
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  datum        DateTime @default(now())
  wirksamAb    DateTime?
  typ          String
  titel        String
  beschreibung String?
  feldAlt      String?
  feldNeu      String?
  createdAt    DateTime @default(now())
}

model Reminder {
  id               Int      @id @default(autoincrement())
  contractId       Int
  contract         Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  bezeichnung      String?
  vorlaufTage      Int
  erinnerungsDatum DateTime
  typ              String   @default("dashboard")
  status           String   @default("ausstehend")
  gesendetAm       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ReminderDefault {
  id          Int     @id @default(autoincrement())
  vorlaufTage Int
  bezeichnung String
  typ         String  @default("dashboard")
  aktiv       Boolean @default(true)
}

model PriceComparison {
  id                Int      @id @default(autoincrement())
  contractId        Int
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  anbieter          String
  marktpreis        Float
  zahlungsintervall String   @default("monatlich")
  leistung          String?
  quelle            String?
  gueltigBis        DateTime?
  notizen           String?
  erfasstAm         DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Kategorie {
  id    Int    @id @default(autoincrement())
  name  String @unique
  icon  String @default("📄")
  color String @default("#6366F1")
}
